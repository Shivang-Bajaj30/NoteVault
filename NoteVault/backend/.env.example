# ==============================================================================
# NoteVault Backend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to '.env' inside the backend directory:
#   cp .env.example .env
# ==============================================================================

# MongoDB Connection String (Atlas cloud or local mongod)
# Local: mongodb://127.0.0.1:27017/notevault
# Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/notevault
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/notevault

# JWT Secret for authentication tokens
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# Backend listening port
PORT=8080

# Allowed CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Auto-seed demo users & initial course data on server start
NOTEVAULT_DEMO_ENABLED=true

# Google Gemini API Key for AI study chatbot & note generation (optional)
GEMINI_API_KEY=

# Event processing / Kafka settings (optional)
NOTEVAULT_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTEVAULT_STREAMS_HEALTH_URL=http://localhost:8081/api/health/streams
