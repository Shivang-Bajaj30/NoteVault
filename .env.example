# ==============================================================================
# NoteVault Project - Master Environment Variables Example (.env.example)
# ==============================================================================
# Copy this file to '.env' or use the respective variables in 'backend/.env'
# and 'frontend/.env.local'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default local installation)
# MONGODB_URI=mongodb://127.0.0.1:27017/notevault

# Option B: MongoDB Atlas (Cloud Cluster)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/notevault?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/notevault

# MongoDB Atlas Username and Password (optional helpers if automating connections)
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password


# ------------------------------------------------------------------------------
# 2. BACKEND API & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Secret key used to cryptographically sign and verify user JWT sessions
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# Port for the FastAPI backend server (default: 8080)
PORT=8080

# Permitted CORS origins (comma-separated, without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Automatically seed demo users, initial courses, and sample notes on startup
NOTEVAULT_DEMO_ENABLED=true


# ------------------------------------------------------------------------------
# 3. AI STUDY & CONTENT GENERATION (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for AI study assistant, quizzes, and note summarization
GEMINI_API_KEY=
# Alternative variable name for Gemini API key:
# GOOGLE_API_KEY=


# ------------------------------------------------------------------------------
# 4. STREAMING & EVENT PROCESSING (Optional / Advanced)
# ------------------------------------------------------------------------------
# Toggle stream/event processing support
NOTEVAULT_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTEVAULT_STREAMS_HEALTH_URL=http://localhost:8081/api/health/streams


# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Used in NoteVault/frontend/.env.local)
# ------------------------------------------------------------------------------
# Backend API base endpoint for frontend client queries
VITE_API_BASE_URL=http://localhost:8080/api

# Frontend demo mode banner toggle
VITE_DEMO_MODE=false
